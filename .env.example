# ============================================================
# Coffee Bean Analyzer — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- Server ---
PORT=8080
ENVIRONMENT=development  # development | production

# --- ONNX Model Paths ---
ROAST_MODEL_PATH=checkpoints/roast_model.onnx
DEFECT_MODEL_PATH=checkpoints/defect_model.onnx

# --- Supabase PostgreSQL ---
# Use the pooled connection string (port 6543) for the app
DATABASE_URL=postgresql+asyncpg://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# --- Supabase Storage ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_BUCKET=coffee-uploads

# --- Security ---
CORS_ORIGINS=["http://localhost:8080"]
RATE_LIMIT=30/minute

# --- Kaggle (for dataset download only) ---
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key
